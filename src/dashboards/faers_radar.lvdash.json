                  {"name": "pt", "expression": "`pt`"},
                  {"name": "cases", "expression": "`cases`"},
                  {"name": "prr", "expression": "`prr`"},
                  {"name": "ror", "expression": "`ror`"},
                  {"name": "ror_lower", "expression": "`ror_lower`"},
                  {"name": "ror_upper", "expression": "`ror_upper`"},
                  {"name": "chi2", "expression": "`chi2`"}
                ],
                "disaggregated": true
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
