                "disaggregated": false
              }
            }],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {"fieldName": "period", "scale": {"type": "categorical", "sort": {"by": "natural-order"}}, "displayName": "Quarter"},
                "y": {"fieldName": "sum(reports)", "scale": {"type": "quantitative"}, "displayName": "Case reports"}
              },
              "frame": {"showTitle": true, "title": "Case reports per quarter"}
            }
          },
          "position": {"x": 0, "y": 7, "width": 6, "height": 6}
        },
        {
          "widget": {
            "name": "drug-signals-trend",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "ds_drug_quarter",
                "fields": [
                  {"name": "period", "expression": "`period`"},
                  {"name": "sum(robust_signals)", "expression": "SUM(`robust_signals`)"}
                ],
                "disaggregated": false
              }
            }],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {"fieldName": "period", "scale": {"type": "categorical", "sort": {"by": "natural-order"}}, "displayName": "Quarter"},
                "y": {"fieldName": "sum(robust_signals)", "scale": {"type": "quantitative"}, "displayName": "Robust signals"}
              },
              "frame": {"showTitle": true, "title": "Robust signals per quarter"}
            }
          },
          "position": {"x": 6, "y": 7, "width": 6, "height": 6}
        },
        {
          "widget": {
            "name": "top-reactions",
            "queries": [{
              "name": "main_query",
              "query": {
