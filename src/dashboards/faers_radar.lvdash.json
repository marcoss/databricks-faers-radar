          "position": {"x": 0, "y": 13, "width": 12, "height": 7}
        },
        {
          "widget": {
            "name": "signal-table",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "ds_signal_detail",
                "fields": [
